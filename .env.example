# =============================================================================
# geo-deep-learning — orchestrator environment (copy to .env, NEVER commit .env)
# Used by: event_detection_orchestrator, model_benchmark_orchestrator (docker-compose.yaml)
# =============================================================================

# --- Database (same PostgreSQL as SCANFIRE) — REQUIRED ---
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=5

# --- Logging ---
# LOGGER_LEVEL=INFO

# --- Model benchmark (profile "benchmark", dev plan 2026-10-08_model_benchmark_predict.md) ---
# Also overridable from the host shell at `make benchmark-start` time.
# Root of the outputs (<root>/<model>/<event_id>/*.tif); empty ⇒ output_root of configs/benchmark/models.yaml
# BENCHMARK_OUTPUT_DIR=
# CSV + override exported per model (<dir>/<model>/vw_input_files_for_model_test.csv)
# BENCHMARK_CSV_DIR=/mnt/geospatial/projet_RCM_scanfire/benchmark_outputs/_csv
